# Sublime: environment variables (names only; never commit real values).
# Copy to .env.local for local development, or to the VPS env file per environment.

# production | staging. Production keeps every backend feature off unless its
# SUBLIME_*_IN_PRODUCTION switch is "enabled".
SUBLIME_ENV=staging

# PostgreSQL (one database per environment).
DATABASE_URL=postgres://sublime:CHANGE_ME@postgres:5432/sublime_staging
# DATABASE_POOL_MAX=10

# Accounts (Better Auth). Secret: 32+ random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public URL of this deployment; sign-in only works from this origin.
BETTER_AUTH_URL=https://staging.sublime.consulte.app

# SEO. Public URL for canonical links, sitemap and structured data (defaults to BETTER_AUTH_URL).
# SITE_URL=https://sublimestudio.com.ar
# Lets search engines index the store. Only honored with SUBLIME_ENV=production; read at build time.
# SITE_INDEXABLE=true

# Uploaded photos and private attachments (a Docker volume on the VPS).
MEDIA_ROOT=/data/media

# Mercado Pago (online payments). See docs/backend/fase-5-pagos.md.
# Application credentials from https://www.mercadopago.com.ar/developers/panel/app (not the seller's).
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=
# Webhooks > "Clave secreta" of the same application.
# MERCADOPAGO_WEBHOOK_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts the connected account's tokens;
# changing it means connecting Mercado Pago again.
# PAYMENTS_ENCRYPTION_KEY=
# Optional direct mode: Access Token of the application owner's account, used while no account is
# connected from Admin > Integraciones. In staging use the TEST credentials ("Prueba" tab).
# MERCADOPAGO_ACCESS_TOKEN=
# "true" while testing with Mercado Pago test users (sandbox credentials on connect).
# MERCADOPAGO_TEST_MODE=true

# Production switches (only read when SUBLIME_ENV=production).
# SUBLIME_DB_IN_PRODUCTION=enabled
# SUBLIME_AUTH_IN_PRODUCTION=enabled
# SUBLIME_MEDIA_IN_PRODUCTION=enabled
# SUBLIME_PAYMENTS_IN_PRODUCTION=enabled
