{
  "name": "sublime_ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"tests/*.test.mjs\"",
    "art": "node scripts/generate-art.mjs",
    "db:dry-run": "node scripts/catalog-import-dry-run.mjs",
    "db:status": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs --target=staging",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs --target=staging --apply",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs --target=staging --apply --seed",
    "test:db": "node --env-file-if-exists=.env.local --test tests/db-integration.test.mjs",
    "admin:grant": "node --env-file-if-exists=.env.local scripts/admin-grant.mjs --target=staging"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.7.0-beta",
    "@neondatabase/serverless": "^1.0.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
